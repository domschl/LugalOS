# Build directories
build/
.cache/

# Packaged release UF2s (dist/README.md documents how to regenerate them --
# binary build output, same reasoning as build/ above, not source).
dist/*.uf2
dist/SHA256SUMS
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja

# Compiled binary & assembly outputs
*.elf
*.bin
*.asm
*.o
*.obj

# ...except the CYW43439 wireless firmware. These .bin files are not build
# output: they are licensed redistributables that ship in the image because
# the chip has no flash of its own (Infineon Permissive Binary License;
# provenance and SHA-256s in firmware/cyw43/README.md).
!firmware/cyw43/*.bin

# Editor & OS temporary files
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/

# uv-managed Python venvs (tests/hw/) -- pyproject.toml and uv.lock are
# committed, the venv itself is reproducible via `uv sync`.
.venv/
blink_test/
tools/picotool
