;;; ============================================================================
;;; LugalOS CAS (Computer Algebra System) - Milestone 43.2
;;; Symbolic Expression Canonicalization & Pattern Simplifier
;;; ============================================================================
;;;
;;; Provides:
;;;   (simplify expr)             - Main entry point: simplifies an expression to canonical form
;;;   (cas-expr<? a b)            - Canonical expression total ordering predicate
;;;   (cas-sort lst lt?)          - Functional merge sort on lists
;;;   (cas-flatten-op op args)    - Associative operator flattening
;;;   (simplify-add args)         - Simplifies additive expressions (+ ...)
;;;   (simplify-mul args)         - Simplifies multiplicative expressions (* ...)
;;;   (simplify-pow base exp)     - Simplifies exponentiation (^ base exp)
;;;   (simplify-sqrt x)           - Exact radical extraction & simplification
;;;   (trig-simplify expr)        - Trigonometric & hyperbolic identity transformation
;;;

;;; --- 1. Total Ordering & Sorting ---

(define (cas-rank x)
  (cond ((number? x) 1)
        ((symbol? x) 2)
        ((pair? x) 3)
        (else 4)))

(define (cas-list<? la lb)
  (cond ((null? la) (not (null? lb)))
        ((null? lb) #f)
        ((cas-expr<? (car la) (car lb)) #t)
        ((cas-expr<? (car lb) (car la)) #f)
        (else (cas-list<? (cdr la) (cdr lb)))))

(define (cas-expr<? a b)
  (let ((ra (cas-rank a))
        (rb (cas-rank b)))
    (cond ((< ra rb) #t)
          ((> ra rb) #f)
          ((= ra 1) (< a b))
          ((= ra 2) (symbol<? a b))
          ((= ra 3)
           (let ((op-a (car a))
                 (op-b (car b)))
             (cond ((cas-expr<? op-a op-b) #t)
                   ((cas-expr<? op-b op-a) #f)
                   (else
                    (let ((la (length a))
                          (lb (length b)))
                      (cond ((< la lb) #t)
                            ((> la lb) #f)
                            (else (cas-list<? (cdr a) (cdr b)))))))))
          (else #f))))

(define (cas-merge a b lt?)
  (cond ((null? a) b)
        ((null? b) a)
        ((lt? (car b) (car a))
         (cons (car b) (cas-merge a (cdr b) lt?)))
        (else
         (cons (car a) (cas-merge (cdr a) b lt?)))))

(define (cas-split-half lst)
  (if (or (null? lst) (null? (cdr lst)))
      (cons lst '())
      (let split-helper ((fast (cddr lst))
                         (slow (cdr lst))
                         (acc (list (car lst))))
        (if (or (null? fast) (null? (cdr fast)))
            (cons (reverse acc) slow)
            (split-helper (cddr fast) (cdr slow) (cons (car slow) acc))))))

(define (cas-sort lst lt?)
  (if (or (null? lst) (null? (cdr lst)))
      lst
      (let* ((halves (cas-split-half lst))
             (left (car halves))
             (right (cdr halves)))
        (cas-merge (cas-sort left lt?)
                   (cas-sort right lt?)
                   lt?))))

;;; --- 2. Associative Flattening ---

(define (cas-flatten-op op args)
  (let flatten-helper ((items args))
    (cond ((null? items) '())
          ((and (pair? (car items)) (eq? (caar items) op))
           (append (flatten-helper (cdar items))
                   (flatten-helper (cdr items))))
          (else
           (cons (car items) (flatten-helper (cdr items)))))))

;;; --- 3. Exact Integer Square Root Factorization ---

(define cas-small-prime-squares
  '(4 9 25 49 121 169 289 361 529 841 961 1369 1681 1849 2209 2809 3481 3721 4489 5041 5329 6241 6889 7921 9409))

(define (cas-sqrt-factor n)
  (if (<= n 0)
      (list 0 0)
      (let ((s (isqrt n)))
        (if (= (* s s) n)
            (list s 1)
            (let extract ((sq-list cas-small-prime-squares)
                          (curr-d 1)
                          (curr-rem n))
              (cond ((null? sq-list)
                     (let ((rem-s (isqrt curr-rem)))
                       (if (= (* rem-s rem-s) curr-rem)
                           (list (* curr-d rem-s) 1)
                           (list curr-d curr-rem))))
                    (else
                     (let ((sq (car sq-list)))
                       (if (> sq curr-rem)
                           (extract '() curr-d curr-rem)
                           (if (= (remainder curr-rem sq) 0)
                               (let ((p (isqrt sq)))
                                 (extract sq-list (* curr-d p) (quotient curr-rem sq)))
                               (extract (cdr sq-list) curr-d curr-rem)))))))))))

(define (simplify-sqrt x)
  (cond ((equal? x 0) 0)
        ((equal? x 1) 1)
        ((equal? x -1) 'i)
        ((and (number? x) (< x 0))
         (let ((pos-s (simplify-sqrt (- x))))
           (cond ((equal? pos-s 1) 'i)
                 ((number? pos-s) (list '* pos-s 'i))
                 (else (list '* 'i pos-s)))))
        ((eq? x 'i)
         (list '* 1/2 (list 'sqrt 2) (list '+ 1 'i)))
        ((or (equal? x '(* -1 i)) (equal? x '-i))
         (list '* 1/2 (list 'sqrt 2) (list '- 1 'i)))
        ((and (integer? x) (> x 0))
         (let* ((fact (cas-sqrt-factor x))
                (d (car fact))
                (rem (cadr fact)))
           (cond ((= rem 1) d)
                 ((= d 1) (list 'sqrt rem))
                 (else (list '* d (list 'sqrt rem))))))
        ((and (number? x) (> x 0))
         (let* ((num (numerator x))
                (den (denominator x))
                (prod (* num den))
                (fact (cas-sqrt-factor prod))
                (d (car fact))
                (rem (cadr fact))
                (coeff (/ d den)))
           (cond ((= rem 1) coeff)
                 ((= coeff 1) (list 'sqrt rem))
                 (else (list '* coeff (list 'sqrt rem))))))
        ((and (pair? x) (eq? (car x) '^))
         (let ((b (cadr x))
               (p (caddr x)))
           (cond ((equal? p 2) b)
                 ((and (integer? p) (= (remainder p 2) 0))
                  (list '^ b (quotient p 2)))
                 (else (list '^ b (simplify (list '* p 1/2)))))))
        (else
         (list 'sqrt x))))

;;; --- 4. Exponentiation ---

(define (simplify-pow base exp)
  (cond ((equal? exp 0) 1)
        ((equal? exp 1) base)
        ((equal? base 1) 1)
        ((and (or (eq? base 'i) (equal? base '(sqrt -1))) (integer? exp))
         (let ((m (modulo exp 4)))
           (cond ((= m 0) 1)
                 ((= m 1) 'i)
                 ((= m 2) -1)
                 ((= m 3) '(* -1 i)))))
        ((and (or (eq? base 'i) (equal? base '(sqrt -1))) (eq? exp 'i))
         (list 'exp (list '* -1/2 'pi)))
        ((and (or (eq? base 'i) (equal? base '(sqrt -1))) (or (equal? exp '(* -1 i)) (equal? exp '-i)))
         (list 'exp (list '* 1/2 'pi)))
        ((and (number? base) (= base 0) (number? exp) (> exp 0)) 0)
        ((and (number? base) (number? exp))
         (if (integer? exp)
             (expt base exp)
             (if (equal? exp 1/2)
                 (simplify-sqrt base)
                 (list '^ base exp))))
        ((and (pair? base) (eq? (car base) '^))
         (let ((b (cadr base))
               (p1 (caddr base)))
           (simplify (list '^ b (simplify (list '* p1 exp))))))
        ((and (pair? base) (eq? (car base) 'exp))
         (simplify (list 'exp (simplify (list '* (cadr base) exp)))))
        ((and (pair? base) (eq? (car base) '*) (integer? exp))
         (simplify (cons '* (map (lambda (f) (list '^ f exp)) (cdr base)))))
        ((equal? exp 1/2)
         (simplify-sqrt base))
        (else
         (list '^ base exp))))

;;; --- 5. Multiplication ---

(define (cas-mul-decompose-factor f)
  (if (and (pair? f) (eq? (car f) '^))
      (cons (cadr f) (caddr f))
      (cons f 1)))

(define (cas-collect-exps factors)
  (let loop ((rest factors) (exp-args '()) (other '()))
    (if (null? rest)
        (cond ((null? exp-args) other)
              ((null? (cdr exp-args)) (cons (list 'exp (car exp-args)) other))
              (else
               (let ((sum (simplify (cons '+ exp-args))))
                 (if (equal? sum 0)
                     other
                     (cons (list 'exp sum) other)))))
        (let ((f (car rest)))
          (cond ((and (pair? f) (eq? (car f) 'exp))
                 (loop (cdr rest) (cons (cadr f) exp-args) other))
                (else
                 (loop (cdr rest) exp-args (cons f other))))))))

(define (simplify-mul raw-args)
  (let* ((args (cas-flatten-op '* raw-args))
         (num-parts '())
         (var-parts '()))
    (for-each (lambda (x)
                (if (number? x)
                    (set! num-parts (cons x num-parts))
                    (set! var-parts (cons x var-parts))))
              args)
    (let* ((c-prod (apply * (cons 1 num-parts)))
           (var-parts-exp (cas-collect-exps var-parts)))
      (cond ((= c-prod 0) 0)
            ((null? var-parts-exp) c-prod)
            (else
             (let* ((decomposed (map cas-mul-decompose-factor var-parts-exp))
                    (sorted (cas-sort decomposed (lambda (p1 p2) (cas-expr<? (car p1) (car p2)))))
                    (collected-rev
                     (let collect-factors ((sorted-pairs (cdr sorted))
                                           (current-base (caar sorted))
                                           (current-pow (cdar sorted))
                                           (acc '()))
                       (cond ((null? sorted-pairs)
                              (let* ((simp-p (simplify current-pow))
                                     (t-val (cond ((equal? simp-p 0) 1)
                                                  ((equal? simp-p 1) current-base)
                                                  (else (simplify-pow current-base simp-p)))))
                                (if (equal? t-val 1) acc (cons t-val acc))))
                             (else
                              (let* ((pair (car sorted-pairs))
                                     (b (car pair))
                                     (p (cdr pair)))
                                (if (equal? b current-base)
                                    (collect-factors (cdr sorted-pairs)
                                                     current-base
                                                     (list '+ current-pow p)
                                                     acc)
                                    (let* ((simp-p (simplify current-pow))
                                           (t-val (cond ((equal? simp-p 0) 1)
                                                        ((equal? simp-p 1) current-base)
                                                        (else (simplify-pow current-base simp-p)))))
                                      (let ((new-acc (if (equal? t-val 1) acc (cons t-val acc))))
                                        (collect-factors (cdr sorted-pairs) b p new-acc)))))))))
                    (factors-all (reverse collected-rev))
                    (extra-nums (filter number? factors-all))
                    (factors (filter (lambda (f) (not (number? f))) factors-all))
                    (final-c (apply * (cons c-prod extra-nums))))
               (cond ((= final-c 0) 0)
                     ((null? factors) final-c)
                     ((and (not (= final-c 1)) (null? (cdr factors)) (pair? (car factors)) (eq? (caar factors) '+))
                      (simplify (cons '+ (map (lambda (term) (list '* final-c term)) (cdar factors)))))
                     ((= final-c 1)
                      (if (null? (cdr factors))
                          (car factors)
                          (cons '* factors)))
                     (else
                      (cons '* (cons final-c factors))))))))))

;;; --- 6. Addition ---

(define (cas-add-decompose-term t)
  (if (and (pair? t) (eq? (car t) '*))
      (let ((rest (cdr t)))
        (if (and (pair? rest) (number? (car rest)))
            (let ((c (car rest))
                  (factors (cdr rest)))
              (cond ((null? factors) (cons c 1))
                    ((null? (cdr factors)) (cons c (car factors)))
                    (else (cons c (cons '* factors)))))
            (cons 1 t)))
      (cons 1 t)))

(define (cas-is-sq-trig? base trig-op)
  (and (pair? base)
       (or (eq? (car base) '^) (eq? (car base) 'expt))
       (pair? (cdr base))
       (pair? (cadr base))
       (eq? (car (cadr base)) trig-op)
       (pair? (cddr base))
       (equal? (caddr base) 2)
       (pair? (cdr (cadr base)))
       (cadr (cadr base))))

(define (cas-reduce-pythagorean pairs)
  (let loop ((rest pairs) (seen '()))
    (if (null? rest)
        (cons 0 pairs)
        (let* ((p (car rest))
               (c (car p))
               (u-sin (cas-is-sq-trig? (cdr p) 'sin)))
          (if u-sin
              (let ((match-cos (let find-cos ((l pairs))
                                 (if (null? l) #f
                                     (let ((p2 (car l)))
                                       (if (and (not (eq? p2 p))
                                                (equal? (car p2) c)
                                                (equal? (cas-is-sq-trig? (cdr p2) 'cos) u-sin))
                                           p2
                                           (find-cos (cdr l))))))))
                (if match-cos
                    (let ((remaining (let rem ((l pairs))
                                       (cond ((null? l) '())
                                             ((or (eq? (car l) p) (eq? (car l) match-cos))
                                              (rem (cdr l)))
                                             (else (cons (car l) (rem (cdr l))))))))
                      (let ((next-red (cas-reduce-pythagorean remaining)))
                        (cons (+ c (car next-red)) (cdr next-red))))
                    (loop (cdr rest) (cons p seen))))
              (loop (cdr rest) (cons p seen)))))))

(define (cas-pair->term p)
  (let ((c (car p))
        (b (cdr p)))
    (cond ((equal? c 1) b)
          ((and (pair? b) (eq? (car b) '*))
           (cons '* (cons c (cdr b))))
          (else (list '* c b)))))

(define (simplify-add raw-args)
  (let* ((args (cas-flatten-op '+ raw-args))
         (num-parts '())
         (var-parts '()))
    (for-each (lambda (x)
                (if (number? x)
                    (set! num-parts (cons x num-parts))
                    (set! var-parts (cons x var-parts))))
              args)
    (let ((c-sum (apply + (cons 0 num-parts))))
      (if (null? var-parts)
          c-sum
          (let* ((decomposed (map cas-add-decompose-term var-parts))
                 (sorted (cas-sort decomposed (lambda (p1 p2) (cas-expr<? (cdr p1) (cdr p2)))))
                 (collected-rev
                  (let collect-terms ((sorted-pairs (cdr sorted))
                                      (current-base (cdar sorted))
                                      (current-c (caar sorted))
                                      (acc '()))
                    (cond ((null? sorted-pairs)
                           (let ((c (simplify current-c)))
                             (cond ((equal? c 0) acc)
                                   ((equal? c 1) (cons current-base acc))
                                   ((and (pair? current-base) (eq? (car current-base) '*))
                                    (cons (cons '* (cons c (cdr current-base))) acc))
                                   (else (cons (list '* c current-base) acc)))))
                          (else
                           (let* ((pair (car sorted-pairs))
                                  (c (car pair))
                                  (b (cdr pair)))
                             (if (equal? b current-base)
                                 (collect-terms (cdr sorted-pairs)
                                                current-base
                                                (list '+ current-c c)
                                                acc)
                                 (let ((sc (simplify current-c)))
                                   (let ((new-acc
                                          (cond ((equal? sc 0) acc)
                                                ((equal? sc 1) (cons current-base acc))
                                                ((and (pair? current-base) (eq? (car current-base) '*))
                                                 (cons (cons '* (cons sc (cdr current-base))) acc))
                                                (else (cons (list '* sc current-base) acc)))))
                                     (collect-terms (cdr sorted-pairs) b c new-acc)))))))))
                 (terms (reverse collected-rev))
                 (pyth (cas-reduce-pythagorean (map cas-add-decompose-term terms)))
                 (final-c-sum (+ c-sum (car pyth)))
                 (final-terms (map cas-pair->term (cdr pyth))))
            (cond ((null? final-terms) final-c-sum)
                  ((= final-c-sum 0)
                   (if (null? (cdr final-terms))
                       (car final-terms)
                       (cons '+ final-terms)))
                  (else
                   (cons '+ (cons final-c-sum final-terms)))))))))

;;; --- 7. Subtraction & Division ---

(define (simplify-sub args)
  (cond ((null? args) 0)
        ((null? (cdr args))
         (simplify (list '* -1 (car args))))
        (else
         (simplify (cons '+ (cons (car args)
                                  (map (lambda (x) (list '* -1 x)) (cdr args))))))))

(define (simplify-div args)
  (cond ((null? args) 1)
        ((null? (cdr args))
         (simplify (list '^ (car args) -1)))
        (else
         (let ((num (car args))
               (den (cadr args)))
           (cond
             ((and (number? den) (not (= den 0)) (pair? num) (eq? (car num) '+))
              (simplify (cons '+ (map (lambda (t) (list '/ t den)) (cdr num)))))
             ((or (eq? den 'i) (equal? den '(sqrt -1)))
              (simplify (list '* '(* -1 i) num)))
             (else
              (simplify (cons '* (cons (car args)
                                       (map (lambda (x) (list '^ x -1)) (cdr args)))))))))))

;;; --- 8. Transcendental & Special Functions ---

(define (cas-is-negative? x)
  (cond ((number? x) (< x 0))
        ((and (pair? x) (eq? (car x) '*) (pair? (cdr x)) (number? (cadr x)))
         (< (cadr x) 0))
        (else #f)))

(define (cas-negate x)
  (simplify (list '* -1 x)))

(define (cas-remove-first item lst)
  (cond ((null? lst) '())
        ((equal? (car lst) item) (cdr lst))
        (else (cons (car lst) (cas-remove-first item (cdr lst))))))

(define (cas-extract-i-factor x)
  (cond
    ((eq? x 'i) 1)
    ((or (equal? x '(* -1 i)) (equal? x '-i)) -1)
    ((and (pair? x) (eq? (car x) '*))
     (let ((factors (cdr x)))
       (if (member 'i factors)
           (let ((rem (cas-remove-first 'i factors)))
             (cond ((null? rem) 1)
                   ((null? (cdr rem)) (car rem))
                   (else (cons '* rem))))
           #f)))
    (else #f)))

(define (cas-extract-pi-multiple x)
  (cond
    ((eq? x 'pi) 1)
    ((and (pair? x) (eq? (car x) '*))
     (let ((factors (cdr x)))
       (cond
         ((and (= (length factors) 2)
               (or (and (number? (car factors)) (eq? (cadr factors) 'pi))
                   (and (eq? (car factors) 'pi) (number? (cadr factors)))))
          (if (number? (car factors)) (car factors) (cadr factors)))
         (else #f))))
    (else #f)))

(define (simplify-exp x)
  (cond ((equal? x 0) 1)
        ((and (pair? x) (eq? (car x) 'log))
         (cadr x))
        ((eq? x 'i)
         (simplify (list '+ (list 'cos 1) (list '* 'i (list 'sin 1)))))
        ((or (equal? x '(* i pi)) (equal? x '(* pi i))) -1)
        ((and (pair? x) (eq? (car x) '*))
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (let* ((theta (simplify i-fac))
                      (pi-mult (cas-extract-pi-multiple theta)))
                 (if pi-mult
                     (simplify (list '+ (list 'cos theta) (list '* 'i (list 'sin theta))))
                     (list 'exp x)))
               (list 'exp x))))
        ((and (pair? x) (eq? (car x) '+))
         (let* ((terms (cdr x))
                (i-terms (filter cas-has-i? terms))
                (non-i-terms (filter (lambda (t) (not (cas-has-i? t))) terms)))
           (if (and (not (null? i-terms)) (not (null? non-i-terms)))
               (let ((re (simplify (if (null? (cdr non-i-terms)) (car non-i-terms) (cons '+ non-i-terms))))
                     (im (simplify (if (null? (cdr i-terms)) (car i-terms) (cons '+ i-terms)))))
                 (simplify (list '* (list 'exp re) (list 'exp im))))
               (list 'exp x))))
        (else (list 'exp x))))

(define (simplify-log x)
  (cond ((equal? x 1) 0)
        ((equal? x -1) '(* i pi))
        ((eq? x 'i) (simplify (list '* 1/2 (list '* 'i 'pi))))
        ((or (equal? x '(* -1 i)) (equal? x '-i))
         (simplify (list '* -1/2 (list '* 'i 'pi))))
        ((and (number? x) (< x 0))
         (simplify (list '+ (list 'log (- x)) '(* i pi))))
        ((and (pair? x) (eq? (car x) '*)
              (pair? (cdr x)) (number? (cadr x))
              (pair? (cddr x)) (eq? (caddr x) 'i))
         (let ((c (cadr x)))
           (if (> c 0)
               (simplify (list '+ (list 'log c) (list '* 1/2 (list '* 'i 'pi))))
               (simplify (list '+ (list 'log (- c)) (list '* -1/2 (list '* 'i 'pi)))))))
        ((and (pair? x) (eq? (car x) 'exp))
         (cadr x))
        (else (list 'log x))))

(define (simplify-sin x)
  (cond ((equal? x 0) 0)
        ((cas-is-negative? x)
         (simplify (list '* -1 (list 'sin (cas-negate x)))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list '* 'i (list 'sinh (simplify i-fac))))
               (let ((pi-mult (cas-extract-pi-multiple x)))
                 (cond
                   ((and pi-mult (integer? pi-mult)) 0)
                   ((and pi-mult (number? pi-mult) (= (denominator pi-mult) 2))
                    (let ((m (modulo (numerator pi-mult) 4)))
                      (cond ((= m 1) 1)
                            ((= m 3) -1)
                            (else (list 'sin x)))))
                    (else (list 'sin x)))))))))

(define (simplify-cos x)
  (cond ((equal? x 0) 1)
        ((cas-is-negative? x)
         (simplify (list 'cos (cas-negate x))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list 'cosh (simplify i-fac)))
               (let ((pi-mult (cas-extract-pi-multiple x)))
                 (cond
                   ((and pi-mult (integer? pi-mult))
                    (if (= (remainder pi-mult 2) 0) 1 -1))
                   ((and pi-mult (number? pi-mult) (= (denominator pi-mult) 2))
                    0)
                   (else (list 'cos x)))))))))

(define (simplify-tan x)
  (cond ((equal? x 0) 0)
        ((cas-is-negative? x)
         (simplify (list '* -1 (list 'tan (cas-negate x)))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list '* 'i (list 'tanh (simplify i-fac))))
               (let ((pi-mult (cas-extract-pi-multiple x)))
                 (cond
                   ((and pi-mult (integer? pi-mult)) 0)
                   ((and pi-mult (number? pi-mult) (= (denominator pi-mult) 4))
                    (let ((m (modulo (numerator pi-mult) 4)))
                      (cond ((= m 1) 1)
                            ((= m 3) -1)
                            (else (list 'tan x)))))
                   (else (list 'tan x)))))))))

(define (simplify-sinh x)
  (cond ((equal? x 0) 0)
        ((cas-is-negative? x)
         (simplify (list '* -1 (list 'sinh (cas-negate x)))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list '* 'i (list 'sin (simplify i-fac))))
               (list 'sinh x))))))

(define (simplify-cosh x)
  (cond ((equal? x 0) 1)
        ((cas-is-negative? x)
         (simplify (list 'cosh (cas-negate x))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list 'cos (simplify i-fac)))
               (list 'cosh x))))))

(define (simplify-tanh x)
  (cond ((equal? x 0) 0)
        ((cas-is-negative? x)
         (simplify (list '* -1 (list 'tanh (cas-negate x)))))
        (else
         (let ((i-fac (cas-extract-i-factor x)))
           (if i-fac
               (simplify (list '* 'i (list 'tan (simplify i-fac))))
               (list 'tanh x))))))

(define (simplify-abs x)
  (cond ((number? x) (abs x))
        ((and (pair? x) (eq? (car x) '*))
         (let ((c (cas-add-decompose-term x)))
           (if (< (car c) 0)
               (list 'abs (simplify (list '* (- (car c)) (cdr c))))
               (list 'abs x))))
        (else (list 'abs x))))

;;; --- 9. Main Simplifier Dispatch & Fixed-Point Loop ---

(define (simplify-step expr)
  (cond ((not (pair? expr)) expr)
        (else
         (let ((op (car expr))
               (args (map simplify (cdr expr))))
           (cond ((eq? op '+) (simplify-add args))
                 ((eq? op '*) (simplify-mul args))
                 ((eq? op '-) (simplify-sub args))
                 ((eq? op '/) (simplify-div args))
                 ((or (eq? op '^) (eq? op 'expt))
                  (if (= (length args) 2)
                      (simplify-pow (car args) (cadr args))
                      (cons op args)))
                 ((eq? op 'sqrt)
                  (if (= (length args) 1)
                      (simplify-sqrt (car args))
                      (cons op args)))
                 ((eq? op 'exp)
                  (if (= (length args) 1)
                      (simplify-exp (car args))
                      (cons op args)))
                 ((eq? op 'log)
                  (if (= (length args) 1)
                      (simplify-log (car args))
                      (cons op args)))
                 ((eq? op 'sin)
                  (if (= (length args) 1)
                      (simplify-sin (car args))
                      (cons op args)))
                 ((eq? op 'cos)
                  (if (= (length args) 1)
                      (simplify-cos (car args))
                      (cons op args)))
                 ((eq? op 'tan)
                  (if (= (length args) 1)
                      (simplify-tan (car args))
                      (cons op args)))
                 ((eq? op 'sinh)
                  (if (= (length args) 1)
                      (simplify-sinh (car args))
                      (cons op args)))
                 ((eq? op 'cosh)
                  (if (= (length args) 1)
                      (simplify-cosh (car args))
                      (cons op args)))
                 ((eq? op 'tanh)
                  (if (= (length args) 1)
                      (simplify-tanh (car args))
                      (cons op args)))
                 ((eq? op 'abs)
                  (if (= (length args) 1)
                      (simplify-abs (car args))
                      (cons op args)))
                 (else
                  (cons op args)))))))

(define (simplify expr)
  (let loop ((cur expr) (count 10))
    (if (<= count 0)
        cur
        (let ((next (simplify-step cur)))
          (if (equal? cur next)
              cur
              (loop next (- count 1)))))))

;;; --- 10. Trigonometric & Hyperbolic Transformation Rules (trig-simplify) ---

(define (trig-simplify expr)
  (let ((s (simplify expr)))
    (cond ((not (pair? s)) s)
          ;; sin(2u) -> 2 sin(u) cos(u)
          ((and (eq? (car s) 'sin)
                (pair? (cdr s))
                (pair? (cadr s))
                (eq? (car (cadr s)) '*)
                (pair? (cdr (cadr s)))
                (equal? (cadr (cadr s)) 2))
           (let ((u (simplify (cons '* (cddr (cadr s))))))
             (simplify (list '* 2 (list 'sin u) (list 'cos u)))))
          ;; 1 + tan^2(u) -> sec^2(u)
          ((and (eq? (car s) '+)
                (member 1 (cdr s)))
           (let ((tan-sq (let find-tan ((l (cdr s)))
                           (if (null? l) #f
                               (if (cas-is-sq-trig? (car l) 'tan)
                                   (car l)
                                   (find-tan (cdr l)))))))
             (if tan-sq
                 (let* ((u (cas-is-sq-trig? tan-sq 'tan))
                        (other (let rem ((l (cdr s)) (r-1 #f) (r-t #f))
                                 (cond ((null? l) '())
                                       ((and (not r-1) (equal? (car l) 1))
                                        (rem (cdr l) #t r-t))
                                       ((and (not r-t) (equal? (car l) tan-sq))
                                        (rem (cdr l) r-1 #t))
                                       (else (cons (car l) (rem (cdr l) r-1 r-t)))))))
                   (simplify (cons '+ (cons (list '^ (list 'sec u) 2) other))))
                 (cons '+ (map trig-simplify (cdr s))))))
          ;; cosh^2(u) - sinh^2(u) -> 1
          ((eq? (car s) '+)
           (let loop ((terms (cdr s)) (cosh-t #f) (sinh-t #f))
             (cond ((null? terms)
                    (if (and cosh-t sinh-t)
                        (let ((u (cas-is-sq-trig? cosh-t 'cosh)))
                          (if (and u (equal? u (cas-is-sq-trig? (caddr sinh-t) 'sinh)))
                              (let ((other (let rem ((l (cdr s)) (r-c #f) (r-s #f))
                                             (cond ((null? l) '())
                                                   ((and (not r-c) (equal? (car l) cosh-t))
                                                    (rem (cdr l) #t r-s))
                                                   ((and (not r-s) (equal? (car l) sinh-t))
                                                    (rem (cdr l) r-c #t))
                                                   (else (cons (car l) (rem (cdr l) r-c r-s)))))))
                                (simplify (cons '+ (cons 1 other))))
                              (cons '+ (map trig-simplify (cdr s)))))
                        (cons '+ (map trig-simplify (cdr s)))))
                   (else
                    (let ((t (car terms)))
                      (cond ((cas-is-sq-trig? t 'cosh)
                             (loop (cdr terms) t sinh-t))
                            ((and (pair? t) (eq? (car t) '*)
                                  (pair? (cdr t)) (equal? (cadr t) -1)
                                  (pair? (cddr t)) (cas-is-sq-trig? (caddr t) 'sinh))
                             (loop (cdr terms) cosh-t t))
                            (else
                             (loop (cdr terms) cosh-t sinh-t))))))))
          (else
           (cons (car s) (map trig-simplify (cdr s)))))))

;;; --- 12. Complex Algebraic Operations ---

(define (cas-has-i? expr)
  (cond ((eq? expr 'i) #t)
        ((not (pair? expr)) #f)
        (else (or (cas-has-i? (car expr)) (cas-has-i? (cdr expr))))))

(define (cas-real-part expr)
  (cond ((number? expr) (real-part expr))
        ((eq? expr 'i) 0)
        ((not (pair? expr)) expr)
        ((eq? (car expr) '+)
         (let ((non-i (filter (lambda (t) (not (cas-has-i? t))) (cdr expr))))
           (simplify (cons '+ (cons 0 non-i)))))
        ((eq? (car expr) '*)
         (if (cas-has-i? expr) 0 expr))
        (else expr)))

(define (cas-imag-part expr)
  (cond ((number? expr) (imag-part expr))
        ((eq? expr 'i) 1)
        ((not (pair? expr)) 0)
        ((eq? (car expr) '+)
         (let ((i-terms (filter cas-has-i? (cdr expr))))
           (simplify (cons '+ (map cas-imag-part i-terms)))))
        ((eq? (car expr) '*)
         (let* ((factors (cdr expr))
                (non-i (filter (lambda (f) (not (eq? f 'i))) factors)))
           (cond ((null? non-i) 1)
                 ((null? (cdr non-i)) (car non-i))
                 (else (cons '* non-i)))))
        (else 0)))

(define (cas-conjugate expr)
  (cond ((number? expr) (conjugate expr))
        ((eq? expr 'i) '(* -1 i))
        ((not (pair? expr)) expr)
        ((eq? (car expr) '+)
         (simplify (cons '+ (map cas-conjugate (cdr expr)))))
        ((eq? (car expr) '*)
         (simplify (cons '* (map cas-conjugate (cdr expr)))))
        ((eq? (car expr) '-)
         (simplify (cons '- (map cas-conjugate (cdr expr)))))
        ((eq? (car expr) '/)
         (simplify (cons '/ (map cas-conjugate (cdr expr)))))
        ((or (eq? (car expr) '^) (eq? (car expr) 'expt))
         (simplify (list '^ (cas-conjugate (cadr expr)) (caddr expr))))
        (else expr)))

(define (cas-complex-abs expr)
  (let ((re (cas-real-part expr))
        (im (cas-imag-part expr)))
    (simplify (list 'sqrt (list '+ (list '^ re 2) (list '^ im 2))))))

;;; --- 13. Conversions between Trigonometric & Exponential Forms (to-exp, to-trig) ---

(define (to-exp expr)
  (cond
    ((not (pair? expr)) expr)
    ((eq? (car expr) 'sin)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '- (list 'exp (list '* 'i u))
                                   (list 'exp (list '* -1 (list '* 'i u))))
                       (list '* 2 'i)))))
    ((eq? (car expr) 'cos)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '+ (list 'exp (list '* 'i u))
                                   (list 'exp (list '* -1 (list '* 'i u))))
                       2))))
    ((eq? (car expr) 'tan)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '- (list 'exp (list '* 'i u))
                                   (list 'exp (list '* -1 (list '* 'i u))))
                       (list '* 'i (list '+ (list 'exp (list '* 'i u))
                                            (list 'exp (list '* -1 (list '* 'i u)))))))))
    ((eq? (car expr) 'sinh)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '- (list 'exp u) (list 'exp (list '* -1 u))) 2))))
    ((eq? (car expr) 'cosh)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '+ (list 'exp u) (list 'exp (list '* -1 u))) 2))))
    ((eq? (car expr) 'tanh)
     (let ((u (to-exp (cadr expr))))
       (simplify (list '/ (list '- (list 'exp u) (list 'exp (list '* -1 u)))
                          (list '+ (list 'exp u) (list 'exp (list '* -1 u)))))))
    (else
     (cons (car expr) (map to-exp (cdr expr))))))

(define (to-trig expr)
  (cond
    ((not (pair? expr)) expr)
    ((eq? (car expr) 'exp)
     (let ((u (cadr expr)))
       (let ((i-fac (cas-extract-i-factor u)))
         (if i-fac
             (simplify (list '+ (list 'cos (to-trig i-fac))
                                (list '* 'i (list 'sin (to-trig i-fac)))))
             (list 'exp (to-trig u))))))
    (else
     (cons (car expr) (map to-trig (cdr expr))))))

