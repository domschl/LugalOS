;;; ============================================================================
;;; LugalOS CAS (Computer Algebra System) - Milestone 43.3
;;; Polynomial Algebra, Expansion, Inspection & Evaluation
;;; ============================================================================
;;;
;;; Provides:
;;;   (expand expr)               - Full distributive expansion of products and powers
;;;   (poly-degree expr var)      - Degree of polynomial in var
;;;   (poly-coeffs expr var)      - List of coefficients in descending order of powers
;;;   (poly-lead-coeff expr var)  - Leading coefficient
;;;   (poly-eval expr bindings)   - Evaluate polynomial with variable assignments
;;;   (poly-eval-horner coeffs x) - Evaluate polynomial coefficients using Horner's rule
;;;   (poly-div num den var)      - Polynomial division returning (quotient remainder)
;;;   (poly-add p1 p2)            - Add two polynomials
;;;   (poly-mul p1 p2)            - Multiply two polynomials with expansion
;;;   (poly-factor expr var)      - Factor polynomial into irreducible factors (degrees 1..4+)
;;;   (apart expr [den] var)      - Partial fraction decomposition (degrees 1..4+)
;;;

;;; --- 1. Polynomial Expansion (expand) ---

(define (cas-expand-mul-2 p q)
  (cond ((or (equal? p 0) (equal? q 0)) 0)
        ((equal? p 1) q)
        ((equal? q 1) p)
        ;; Both p and q are sums: (+ a1 a2 ...) * (+ b1 b2 ...)
        ((and (pair? p) (eq? (car p) '+) (pair? q) (eq? (car q) '+))
         (let outer ((ts1 (cdr p)) (all-terms '()))
           (if (null? ts1)
               (simplify (cons '+ (reverse all-terms)))
               (let inner ((ts2 (cdr q)) (sub-terms '()))
                 (if (null? ts2)
                     (outer (cdr ts1) (append sub-terms all-terms))
                     (inner (cdr ts2)
                            (cons (expand (list '* (car ts1) (car ts2)))
                                  sub-terms)))))))
        ;; p is a sum (+ a1 a2 ...): distribute q across each term
        ((and (pair? p) (eq? (car p) '+))
         (simplify (cons '+ (map (lambda (a) (expand (list '* a q))) (cdr p)))))
        ;; q is a sum (+ b1 b2 ...): distribute p across each term
        ((and (pair? q) (eq? (car q) '+))
         (simplify (cons '+ (map (lambda (b) (expand (list '* p b))) (cdr q)))))
        ;; Neither is a sum: direct product simplified
        (else
         (simplify (list '* p q)))))

(define (cas-expand-mul args)
  (let loop ((rest args) (acc 1))
    (if (null? rest)
        acc
        (loop (cdr rest) (cas-expand-mul-2 acc (expand (car rest)))))))

(define (cas-expand-pow base exp)
  (cond ((= exp 0) 1)
        ((= exp 1) base)
        ((= exp 2) (cas-expand-mul-2 base base))
        ((= (remainder exp 2) 0)
         (let ((half (cas-expand-pow base (/ exp 2))))
           (cas-expand-mul-2 half half)))
        (else
         (cas-expand-mul-2 base (cas-expand-pow base (- exp 1))))))

(define (expand expr)
  (cond ((not (pair? expr)) expr)
        ((eq? (car expr) '+)
         (simplify (cons '+ (map expand (cdr expr)))))
        ((eq? (car expr) '-)
         (if (null? (cddr expr))
             (cas-expand-mul-2 -1 (expand (cadr expr)))
             (expand (cons '+ (cons (cadr expr)
                                    (map (lambda (x) (list '* -1 x)) (cddr expr)))))))
        ((eq? (car expr) '*)
         (cas-expand-mul (cdr expr)))
        ((eq? (car expr) '^)
         (let ((b (expand (cadr expr)))
               (e (caddr expr)))
           (if (and (integer? e) (> e 0))
               (cas-expand-pow b e)
               (simplify (list '^ b (expand e))))))
        ((eq? (car expr) '/)
         (simplify (list '/ (expand (cadr expr)) (expand (caddr expr)))))
        (else
         (cons (car expr) (map expand (cdr expr))))))

;;; --- 2. Polynomial Inspection ---

(define (poly-has-var? expr var)
  (cond ((eq? expr var) #t)
        ((pair? expr)
         (or (poly-has-var? (car expr) var)
             (poly-has-var? (cdr expr) var)))
        (else #f)))

(define (poly-term-degree term var)
  (cond ((not (poly-has-var? term var)) 0)
        ((eq? term var) 1)
        ((and (pair? term) (eq? (car term) '^) (eq? (cadr term) var))
         (if (integer? (caddr term)) (caddr term) 1))
        ((and (pair? term) (eq? (car term) '*))
         (let loop ((factors (cdr term)) (deg 0))
           (if (null? factors)
               deg
               (loop (cdr factors) (+ deg (poly-term-degree (car factors) var))))))
        (else 0)))

(define (poly-term-coeff term var)
  (cond ((not (poly-has-var? term var)) term)
        ((eq? term var) 1)
        ((and (pair? term) (eq? (car term) '^) (eq? (cadr term) var)) 1)
        ((and (pair? term) (eq? (car term) '*))
         (let loop ((factors (cdr term)) (c-factors '()))
           (if (null? factors)
               (cond ((null? c-factors) 1)
                     ((null? (cdr c-factors)) (car c-factors))
                     (else (simplify (cons '* (reverse c-factors)))))
               (let ((f (car factors)))
                 (if (poly-has-var? f var)
                     (loop (cdr factors) c-factors)
                     (loop (cdr factors) (cons f c-factors)))))))
        (else term)))

(define (poly-degree expr var)
  (let ((e (simplify (expand expr))))
    (cond ((not (poly-has-var? e var)) 0)
          ((eq? e var) 1)
          ((and (pair? e) (eq? (car e) '^))
           (if (eq? (cadr e) var) (caddr e) 0))
          ((and (pair? e) (eq? (car e) '*))
           (poly-term-degree e var))
          ((and (pair? e) (eq? (car e) '+))
           (let loop ((terms (cdr e)) (max-deg 0))
             (if (null? terms)
                 max-deg
                 (let ((d (poly-term-degree (car terms) var)))
                   (loop (cdr terms) (if (> d max-deg) d max-deg))))))
          (else 0))))

(define (poly-coeffs expr var)
  (let* ((e (simplify (expand expr)))
         (deg (poly-degree e var)))
    (if (= deg 0)
        (list e)
        (let ((terms (if (and (pair? e) (eq? (car e) '+))
                         (cdr e)
                         (list e))))
          (let loop ((k deg) (acc '()))
            (if (< k 0)
                (reverse acc)
                (let ((k-coeffs (let find ((ts terms) (matches '()))
                                  (if (null? ts)
                                      matches
                                      (let ((t (car ts)))
                                        (if (= (poly-term-degree t var) k)
                                            (find (cdr ts) (cons (poly-term-coeff t var) matches))
                                            (find (cdr ts) matches)))))))
                  (let ((coeff (cond ((null? k-coeffs) 0)
                                     ((null? (cdr k-coeffs)) (car k-coeffs))
                                     (else (simplify (cons '+ k-coeffs))))))
                    (loop (- k 1) (cons coeff acc))))))))))

(define (poly-lead-coeff expr var)
  (car (poly-coeffs expr var)))

;;; --- 3. Polynomial Evaluation & Horner's Rule ---

(define (poly-eval-horner coeffs x-val)
  (if (null? coeffs)
      0
      (let loop ((cs (cdr coeffs)) (acc (car coeffs)))
        (if (null? cs)
            (simplify acc)
            (loop (cdr cs) (simplify (list '+ (list '* acc x-val) (car cs))))))))

(define (poly-subst expr bindings)
  (cond ((symbol? expr)
         (let ((pair (assoc expr bindings)))
           (if pair (cdr pair) expr)))
        ((pair? expr)
         (cons (poly-subst (car expr) bindings)
               (poly-subst (cdr expr) bindings)))
        (else expr)))

(define (poly-eval expr bindings)
  (simplify (expand (poly-subst expr bindings))))

;;; --- 4. Polynomial Division (Long Division) ---

(define (poly-div num den var)
  (let ((p1 (simplify (expand num)))
        (p2 (simplify (expand den))))
    (let ((d2 (poly-degree p2 var))
          (lc2 (poly-lead-coeff p2 var)))
      (if (and (= d2 0) (equal? lc2 0))
          (list 'division-by-zero 'division-by-zero)
          (let loop ((r p1) (q 0))
            (let ((dr (poly-degree r var)))
              (if (or (< dr d2) (and (= dr 0) (equal? r 0)))
                  (list (simplify q) (simplify r))
                  (let* ((lcr (poly-lead-coeff r var))
                         (term-c (simplify (list '/ lcr lc2)))
                         (term-deg (- dr d2))
                         (term (cond ((= term-deg 0) term-c)
                                     ((= term-deg 1) (simplify (list '* term-c var)))
                                     (else (simplify (list '* term-c (list '^ var term-deg))))))
                         (new-q (simplify (list '+ q term)))
                         (sub (expand (list '* term p2)))
                         (new-r (simplify (expand (list '- r sub)))))
                    (loop new-r new-q)))))))))

;;; --- 5. High-Level Arithmetic Aliases ---

(define (poly-add p1 p2)
  (simplify (list '+ p1 p2)))

(define (poly-mul p1 p2)
  (expand (list '* p1 p2)))

;;; --- 6. Polynomial Factorization & Rational Roots (Milestone 48.3d) ---

(define (cas-divisors n)
  (let ((an (abs n)))
    (if (<= an 0) '(1)
        (let loop ((d 1) (acc '()))
          (cond ((> (* d d) an)
                 (cas-sort acc <))
                ((= (remainder an d) 0)
                 (let ((q (/ an d)))
                   (if (= d q)
                       (loop (+ d 1) (cons d acc))
                       (loop (+ d 1) (cons d (cons q acc))))))
                (else
                 (loop (+ d 1) acc)))))))

(define (cas-poly-clear-denoms coeffs)
  (let* ((dens (map (lambda (c) (if (number? c) (denominator c) 1)) coeffs))
         (common-den (let loop ((ds dens) (acc 1))
                       (if (null? ds) acc
                           (let ((d (car ds)))
                             (loop (cdr ds) (/ (* acc d) (gcd acc d))))))))
    (map (lambda (c) (if (number? c) (* c common-den) c)) coeffs)))

(define (cas-poly-rational-roots p-expr var)
  (let* ((raw-cs (poly-coeffs p-expr var))
         (deg (poly-degree p-expr var)))
    (if (or (<= deg 0)
            (let check ((cs raw-cs))
              (cond ((null? cs) #f)
                    ((not (number? (car cs))) #t)
                    (else (check (cdr cs))))))
        '()
        (let* ((cs (cas-poly-clear-denoms raw-cs))
               (lead (abs (car cs)))
               (const-term (abs (car (reverse cs)))))
          (if (= const-term 0)
              (let* ((div-res (poly-div p-expr var var))
                     (quot (car div-res)))
                (cons 0 (cas-poly-rational-roots quot var)))
              (let* ((p-divs (cas-divisors const-term))
                     (q-divs (cas-divisors lead))
                     (roots '()))
                (let loop-q ((qs q-divs))
                  (if (null? qs)
                      (cas-sort roots <)
                      (let ((q (car qs)))
                        (let loop-p ((ps p-divs))
                          (if (null? ps)
                              (loop-q (cdr qs))
                              (let ((p (car ps)))
                                (if (= (gcd p q) 1)
                                    (let* ((r (/ p q))
                                           (nr (- r)))
                                      (if (equal? (poly-eval-horner raw-cs r) 0)
                                          (if (not (member r roots))
                                              (set! roots (cons r roots))))
                                      (if (equal? (poly-eval-horner raw-cs nr) 0)
                                          (if (not (member nr roots))
                                              (set! roots (cons nr roots))))))
                                (loop-p (cdr ps))))))))))))))

(define (cas-poly-biquadratic? cur var)
  (let ((cs (poly-coeffs cur var)))
    (and (= (length cs) 5)
         (number? (list-ref cs 0))
         (equal? (list-ref cs 1) 0)
         (number? (list-ref cs 2))
         (equal? (list-ref cs 3) 0)
         (number? (list-ref cs 4)))))

(define (cas-factor-quadratic-diff var u)
  (cond ((= u 0)
         (list (cons var 2)))
        ((> u 0)
         (let ((r (isqrt (numerator u)))
               (rd (isqrt (denominator u))))
           (if (and (= (* r r) (numerator u)) (= (* rd rd) (denominator u)))
               (let ((root (/ r rd)))
                 (list (cons (list '- var root) 1)
                       (cons (list '+ var root) 1)))
               (list (cons (list '- (list '^ var 2) u) 1)))))
        (else
         (list (cons (list '+ (list '^ var 2) (abs u)) 1)))))

(define (cas-factor-biquadratic cur var)
  (let* ((cs (poly-coeffs cur var))
         (a (list-ref cs 0))
         (b (list-ref cs 2))
         (c (list-ref cs 4))
         (disc (- (* b b) (* 4 a c))))
    (if (>= disc 0)
        (let ((s (isqrt disc)))
          (if (= (* s s) disc)
              (let* ((u1 (/ (+ (- b) s) (* 2 a)))
                     (u2 (/ (- (- b) s) (* 2 a)))
                     (sub-f1 (cas-factor-quadratic-diff var u1))
                     (sub-f2 (cas-factor-quadratic-diff var u2)))
                (append sub-f1 sub-f2))
              (list (cons cur 1))))
        (list (cons cur 1)))))

(define (cas-poly-factor-list p-expr var)
  (let loop ((cur (simplify (expand p-expr))) (factors '()))
    (let ((deg (poly-degree cur var)))
      (cond
        ((<= deg 0)
         (if (or (equal? cur 1) (equal? cur 0))
             factors
             (cons (cons cur 1) factors)))
        ((= deg 1)
         (let ((lc (poly-lead-coeff cur var)))
           (if (or (equal? lc 1) (not (number? lc)))
               (cons (cons cur 1) factors)
               (cons (cons lc 1) (cons (cons (simplify (list '/ cur lc)) 1) factors)))))
        (else
         (let ((rts (cas-poly-rational-roots cur var)))
           (if (pair? rts)
               (let* ((r (car rts))
                      (lin-term (if (= r 0) var (list '- var r)))
                      (div-res (poly-div cur lin-term var))
                      (quot (car div-res)))
                 (loop quot (cons (cons lin-term 1) factors)))
               (cond
                 ((= deg 2)
                  (let* ((cs (poly-coeffs cur var)))
                    (if (and (= (length cs) 3)
                             (let check ((l cs))
                               (cond ((null? l) #t)
                                     ((not (number? (car l))) #f)
                                     (else (check (cdr l))))))
                        (let* ((a (car cs)) (b (cadr cs)) (c (caddr cs))
                               (disc (- (* b b) (* 4 a c))))
                          (if (>= disc 0)
                              (let ((s (isqrt disc)))
                                (if (= (* s s) disc)
                                    (let* ((r1 (/ (+ (- b) s) (* 2 a)))
                                           (r2 (/ (- (- b) s) (* 2 a)))
                                           (f1 (if (= r1 0) var (list '- var r1)))
                                           (f2 (if (= r2 0) var (list '- var r2))))
                                      (cons (cons f1 1) (cons (cons f2 1) factors)))
                                    (cons (cons cur 1) factors)))
                              (cons (cons cur 1) factors)))
                        (cons (cons cur 1) factors))))
                 ((and (= deg 4) (cas-poly-biquadratic? cur var))
                  (append (cas-factor-biquadratic cur var) factors))
                 (else
                  (cons (cons cur 1) factors))))))))))

(define (cas-group-factors factor-pairs)
  (let loop ((rest factor-pairs) (acc '()))
    (if (null? rest)
        (reverse acc)
        (let* ((p (car rest))
               (f (car p))
               (pw (cdr p)))
          (if (number? f)
              (loop (cdr rest) (cons p acc))
              (let ((existing (let find ((l acc))
                                (cond ((null? l) #f)
                                      ((equal? (caar l) f) (car l))
                                      (else (find (cdr l)))))))
                (if existing
                    (let ((new-acc
                           (map (lambda (pair)
                                  (if (equal? (car pair) f)
                                      (cons f (+ (cdr pair) pw))
                                      pair))
                                acc)))
                      (loop (cdr rest) new-acc))
                    (loop (cdr rest) (cons p acc)))))))))

(define (poly-factor expr var)
  (let ((fl (cas-group-factors (cas-poly-factor-list expr var))))
    (if (null? fl)
        expr
        (if (null? (cdr fl))
            (let ((f (car fl)))
              (if (= (cdr f) 1) (car f) (list '^ (car f) (cdr f))))
            (cons '* (map (lambda (f)
                            (if (= (cdr f) 1) (car f) (list '^ (car f) (cdr f))))
                          fl))))))

(define (cas-extract-roots sols)
  (cond ((null? sols) '())
        ((or (eq? sols 'all) (eq? sols 'none)) '())
        ((and (pair? sols) (eq? (car sols) 'solve)) '())
        ((and (pair? sols) (not (pair? (car sols))))
         (list (cdr sols)))
        (else
         (map (lambda (pair) (cdr pair)) sols))))

(define (poly-factor-complex expr var)
  (let* ((P (simplify (expand expr)))
         (deg (poly-degree P var)))
    (if (<= deg 1)
        (poly-factor P var)
        (let* ((sols (solve (list '= P 0) var))
               (rts (cas-extract-roots sols)))
          (if (null? rts)
              (poly-factor P var)
              (let loop-roots ((rest-rts rts) (cur P) (factors '()))
                (if (null? rest-rts)
                    (let* ((final-factors
                            (cond ((or (equal? cur 1) (equal? cur 0)) factors)
                                  ((number? cur) (cons (cons cur 1) factors))
                                  (else (cons (cons cur 1) factors))))
                           (fl (cas-group-factors (reverse final-factors))))
                      (if (null? fl)
                          expr
                          (if (null? (cdr fl))
                              (let ((f (car fl)))
                                (if (= (cdr f) 1) (car f) (list '^ (car f) (cdr f))))
                              (cons '* (map (lambda (f)
                                              (if (= (cdr f) 1) (car f) (list '^ (car f) (cdr f))))
                                            fl)))))
                    (let* ((r (car rest-rts))
                           (lin-term (simplify (list '- var r))))
                      (let div-loop ((c cur) (fs factors))
                        (let* ((div-res (poly-div c lin-term var))
                               (quot (car div-res))
                               (rem (cadr div-res)))
                          (if (equal? rem 0)
                              (div-loop quot (cons (cons lin-term 1) fs))
                              (loop-roots (cdr rest-rts) c fs))))))))))))

;;; --- 7. Partial Fraction Decomposition (apart) ---

(define (cas-gauss-elim M n)
  (let loop ((col 0) (cur-M M))
    (if (>= col n)
        (map (lambda (row) (car (reverse row))) cur-M)
        (let ((p (let find-p ((i col))
                   (if (>= i n) #f
                       (if (not (equal? (simplify (list-ref (list-ref cur-M i) col)) 0))
                           i
                           (find-p (+ i 1)))))))
          (if (not p)
              #f
              (let* ((swapped (if (= p col) cur-M
                                  (let ((r1 (list-ref cur-M col))
                                        (r2 (list-ref cur-M p)))
                                    (let swap-rows ((idx 0) (l cur-M))
                                      (if (null? l) '()
                                          (cons (cond ((= idx col) r2)
                                                      ((= idx p) r1)
                                                      (else (car l)))
                                                (swap-rows (+ idx 1) (cdr l))))))))
                     (pivot (list-ref (list-ref swapped col) col))
                     (norm-row (map (lambda (x) (simplify (list '/ x pivot)))
                                    (list-ref swapped col)))
                     (elim-M
                      (let elim-rows ((idx 0) (l swapped))
                        (if (null? l) '()
                            (let ((row (car l)))
                              (if (= idx col)
                                  (cons norm-row (elim-rows (+ idx 1) (cdr l)))
                                  (let ((factor (list-ref row col)))
                                    (if (equal? (simplify factor) 0)
                                        (cons row (elim-rows (+ idx 1) (cdr l)))
                                        (let ((new-row
                                               (map (lambda (ri rk)
                                                      (simplify (list '- ri (list '* factor rk))))
                                                    row norm-row)))
                                          (cons new-row (elim-rows (+ idx 1) (cdr l))))))))))))
                (loop (+ col 1) elim-M)))))))

(define (cas-all-distinct-linear? factors var)
  (let check ((l factors))
    (if (null? l) #t
        (let ((p (car l)))
          (if (number? (car p))
              (check (cdr l))
              (if (and (= (poly-degree (car p) var) 1)
                       (= (cdr p) 1))
                  (check (cdr l))
                  #f))))))

(define (apart expr . rest)
  (let* ((var (if (null? (cdr rest)) (car rest) (cadr rest)))
         (num (if (null? (cdr rest))
                  (if (and (pair? expr) (eq? (car expr) '/)) (cadr expr) expr)
                  expr))
         (den (if (null? (cdr rest))
                  (if (and (pair? expr) (eq? (car expr) '/)) (caddr expr) 1)
                  (car rest)))
         (N (simplify (expand num)))
         (D (simplify (expand den)))
         (degN (poly-degree N var))
         (degD (poly-degree D var)))
    (cond
      ((<= degD 0) (simplify (list '/ N D)))
      ((>= degN degD)
       (let* ((div-res (poly-div N D var))
              (Q (car div-res))
              (R (cadr div-res)))
         (if (equal? R 0)
             Q
             (simplify (list '+ Q (apart R D var))))))
      (else
       ;; Proper fraction: deg(N) < deg(D)
       (let* ((raw-factors (cas-group-factors (cas-poly-factor-list D var)))
              (scalar 1)
              (factors '()))
         (for-each (lambda (f)
                     (if (number? (car f))
                         (set! scalar (* scalar (expt (car f) (cdr f))))
                         (set! factors (cons f factors))))
                   raw-factors)
         (set! factors (reverse factors))
         (cond
           ((null? factors) (simplify (list '/ N D)))
           ((and (null? (cdr factors)) (= (cdar factors) 1))
            (simplify (list '/ N D)))
           ((cas-all-distinct-linear? factors var)
            (let* ((terms
                    (map (lambda (f)
                           (let* ((lin (car f))
                                  (cs (poly-coeffs lin var))
                                  (a (car cs))
                                  (b (cadr cs))
                                  (root (/ (- b) a))
                                  (n-val (poly-eval-horner (poly-coeffs N var) root))
                                  (d-val
                                   (let loop ((other factors) (acc scalar))
                                     (if (null? other) acc
                                         (let ((o-lin (caar other)))
                                           (if (equal? o-lin lin)
                                               (loop (cdr other) acc)
                                               (let ((val (poly-eval-horner (poly-coeffs o-lin var) root)))
                                                 (loop (cdr other) (* acc val))))))))
                                  (coeff (simplify (list '/ n-val d-val))))
                             (if (equal? coeff 0) 0
                                 (list '/ coeff lin))))
                         factors))
                   (non-zero (let filter-zeros ((ts terms))
                               (cond ((null? ts) '())
                                     ((equal? (car ts) 0) (filter-zeros (cdr ts)))
                                     (else (cons (car ts) (filter-zeros (cdr ts))))))))
              (if (null? non-zero) 0
                  (if (null? (cdr non-zero)) (car non-zero)
                      (simplify (cons '+ non-zero))))))
           (else
            (let* ((templates '()))
              (for-each
               (lambda (f-pair)
                 (let* ((F (car f-pair))
                        (k (cdr f-pair))
                        (dF (poly-degree F var)))
                   (let loop-p ((p 1))
                     (if (<= p k)
                         (let* ((F-pow (if (= p 1) F (expand (list '^ F p))))
                                (cofactor (car (poly-div D F-pow var))))
                           (if (= dF 1)
                               (set! templates (cons (list 'const cofactor F-pow) templates))
                               (begin
                                 (set! templates (cons (list 'lin-x (expand (list '* var cofactor)) F-pow) templates))
                                 (set! templates (cons (list 'lin-1 cofactor F-pow) templates))))
                           (loop-p (+ p 1)))))))
               factors)
              (set! templates (reverse templates))
              (let ((num-unknowns (length templates)))
                (let loop-pts ((x-test 0) (pts '()) (rows '()))
                  (if (>= (length pts) num-unknowns)
                      (let ((sol (cas-gauss-elim rows num-unknowns)))
                        (if (not sol)
                            (simplify (list '/ N D))
                            (let extract ((tmpl templates) (s sol) (terms '()))
                              (if (null? tmpl)
                                  (let ((nz (let fz ((l terms))
                                              (cond ((null? l) '())
                                                    ((equal? (car l) 0) (fz (cdr l)))
                                                    (else (cons (car l) (fz (cdr l))))))))
                                    (if (null? nz) 0
                                        (if (null? (cdr nz)) (car nz)
                                            (simplify (cons '+ nz)))))
                                  (let* ((t-entry (car tmpl))
                                         (type (car t-entry))
                                         (t-den (caddr t-entry))
                                         (val (car s)))
                                    (cond
                                      ((eq? type 'const)
                                       (if (equal? val 0)
                                           (extract (cdr tmpl) (cdr s) terms)
                                           (extract (cdr tmpl) (cdr s)
                                                    (cons (list '/ val t-den) terms))))
                                      ((eq? type 'lin-x)
                                       (let* ((val-c (cadr s))
                                              (num-expr (simplify (list '+ (list '* val var) val-c))))
                                         (if (equal? num-expr 0)
                                             (extract (cddr tmpl) (cddr s) terms)
                                             (extract (cddr tmpl) (cddr s)
                                                      (cons (list '/ num-expr t-den) terms)))))))))))
                      (let* ((next-x (if (<= x-test 0) (- 1 x-test) (- x-test)))
                             (r-val (poly-eval-horner (poly-coeffs N var) next-x))
                             (row (append (map (lambda (t)
                                                 (poly-eval-horner (poly-coeffs (cadr t) var) next-x))
                                               templates)
                                          (list r-val))))
                        (loop-pts next-x (cons next-x pts) (cons row rows))))))))))))))
