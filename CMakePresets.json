{
    "version": 2,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
    "configurePresets": [
        {
            "name": "rv32-nommu",
            "displayName": "QEMU RV32 (NOMMU)",
            "description": "QEMU virt machine, 32-bit RISC-V, no MMU (LugalOS's default target).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rv32",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-rv32-nommu.cmake"
            }
        },
        {
            "name": "rv64-mmu",
            "displayName": "QEMU RV64 (Sv39 MMU)",
            "description": "QEMU virt machine, 64-bit RISC-V, Sv39 MMU, S-mode.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rv64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-rv64-mmu.cmake"
            }
        },
        {
            "name": "rp2350-chess",
            "displayName": "RP2350 (Pico 2) — chess-computer persona",
            "description": "Raspberry Pi Pico 2, default board persona: SD card via SPI1, ST7735 TFT + TM1638 keypad + chess engine all built in (plan/phase9_chess_computer.md).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rp2350",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-rp2350.cmake"
            }
        },
        {
            "name": "rp2350-clock",
            "displayName": "RP2350 (Pico 2 / Pico 2 W) — Pico-Clock-Green persona",
            "description": "Waveshare Pico-Clock-Green baseboard (plan/phase11_pico_clock_green.md). GP10-13 drive the SM16106 LED matrix instead of the SD card, so SPI1/SD, the ST7735 TFT and the TM1638 keypad are all built out.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rp2350-clock",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-rp2350.cmake",
                "LUGALOS_BOARD_FILE": "${sourceDir}/cmake/board-rp2350-clock.cmake",
                "LUGALOS_ENABLE_SPISD": "OFF",
                "LUGALOS_ENABLE_ST7735": "OFF",
                "LUGALOS_ENABLE_TM1638": "OFF",
                "LUGALOS_ENABLE_CHESS": "OFF",
                "LUGALOS_ENABLE_PICO_CLOCK_GREEN": "ON",
                "LUGALOS_ENABLE_DCF77": "ON"
            }
        },
        {
            "name": "rp2350-gateway",
            "displayName": "RP2350 (Pico 2) \u2014 network gateway persona",
            "description": "Bare Pico 2 with a W5500 Ethernet module on SPI0 and an SD card on SPI1 (plan/phase18_networking_and_auth.md). No display, keypad, matrix or radio: this board terminates 9P over TCP and re-exports a board reached over UART. NOTE: GP16 is the W5500's MISO, so the heartbeat LED moves to GP25.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/rp2350-gateway",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-rp2350.cmake",
                "LUGALOS_BOARD_FILE": "${sourceDir}/cmake/board-rp2350-gateway.cmake",
                "LUGALOS_ENABLE_SPISD": "ON",
                "LUGALOS_ENABLE_ST7735": "OFF",
                "LUGALOS_ENABLE_TM1638": "OFF",
                "LUGALOS_ENABLE_CHESS": "OFF",
                "LUGALOS_ENABLE_PICO_CLOCK_GREEN": "OFF",
                "LUGALOS_ENABLE_DCF77": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "rv32-nommu", "configurePreset": "rv32-nommu" },
        { "name": "rv64-mmu", "configurePreset": "rv64-mmu" },
        { "name": "rp2350-chess", "configurePreset": "rp2350-chess" },
        { "name": "rp2350-clock", "configurePreset": "rp2350-clock" },
        { "name": "rp2350-gateway", "configurePreset": "rp2350-gateway" }
    ]
}
