;;; LugalOS Sensor Strip-Chart & Telemetry Logging
;;; /sd0/system/lib/chart.lisp

;; (sensor-plot channel [interval-ms] [window-seconds])
;; Live rolling strip-chart plotted on the 1-bpp/RGB canvas.
;; Example: (sensor-plot "temp" 200 30)
(define (sensor-plot channel . opts)
  (let* ((interval (if (null? opts) 200 (car opts)))
         (win-s (if (or (null? opts) (null? (cdr opts))) 30 (cadr opts)))
         (num-samples (/ (* win-s 1000) interval))
         (samples (make-vector num-samples #f))
         (size (canvas-size))
         (w (if (pair? size) (car size) 320))
         (h (if (pair? size) (cadr size) 240))
         (graph-x0 40)
         (graph-y0 30)
         (graph-x1 (- w 20))
         (graph-y1 (- h 20))
         (graph-w (- graph-x1 graph-x0))
         (graph-h (- graph-y1 graph-y0)))
    (display "[Chart] Starting live sensor plot for ")
    (display channel)
    (display " (Ctrl-C to stop)...\n")
    (let loop ((head 0) (count 0))
      (let ((val (sensor-read channel)))
        (when val
          (vector-set! samples head val)
          (let* ((next-head (modulo (+ head 1) num-samples))
                 (next-count (if (< count num-samples) (+ count 1) num-samples)))
            ;; Find min and max of valid samples
            (let minmax-loop ((i 0) (cur-min 99999999) (cur-max -99999999))
              (if (< i next-count)
                  (let ((sample (vector-ref samples i)))
                    (if sample
                        (minmax-loop (+ i 1)
                                     (if (< sample cur-min) sample cur-min)
                                     (if (> sample cur-max) sample cur-max))
                        (minmax-loop (+ i 1) cur-min cur-max)))
                  ;; Draw canvas frame
                  (begin
                    (canvas-fill 0) ;; clear white/dark
                    ;; Draw bounding box
                    (canvas-rect graph-x0 graph-y0 graph-w graph-h 1)
                    ;; Print header text
                    (let ((info (string-append channel ": " (number->string val)
                                               " (min: " (number->string cur-min)
                                               " max: " (number->string cur-max) ")")))
                      (canvas-text graph-x0 8 info 1 1))
                    ;; Plot points
                    (let ((range (if (= cur-min cur-max) 1 (- cur-max cur-min))))
                      (let draw-loop ((step 1))
                        (if (< step next-count)
                            (let* ((idx1 (modulo (- head step) num-samples))
                                   (idx0 (modulo (- head step 1) num-samples))
                                   (y-val1 (vector-ref samples idx1))
                                   (y-val0 (vector-ref samples idx0)))
                              (when (and y-val0 y-val1)
                                (let ((px1 (- graph-x1 (/ (* (- step 1) graph-w) num-samples)))
                                      (py1 (- graph-y1 (/ (* (- y-val1 cur-min) graph-h) range)))
                                      (px0 (- graph-x1 (/ (* step graph-w) num-samples)))
                                      (py0 (- graph-y1 (/ (* (- y-val0 cur-min) graph-h) range))))
                                  (canvas-line px0 py0 px1 py1 1)))
                              (draw-loop (+ step 1)))))))
                    (canvas-swap)
                    (sleep-ms interval)
                    (loop next-head next-count))))))))))

;; (sensor-log file-path channels interval-ms count)
;; Logs comma-separated sensor readings to a file.
;; Example: (sensor-log "/sd0/log.csv" '("temp" "humidity") 500 10)
(define (sensor-log file-path channels interval-ms count)
  (let ((header (string-append "time_us," (string-join channels ",") "\n")))
    (write-file file-path header)
    (let loop ((n 0))
      (if (< n count)
          (let* ((t (number->string (time-us)))
                 (vals (map (lambda (ch)
                              (let ((v (sensor-read ch)))
                                (if v (number->string v) "NA")))
                            channels))
                 (line (string-append t "," (string-join vals ",") "\n")))
            (append-file file-path line)
            (sleep-ms interval-ms)
            (loop (+ n 1)))
          #t))))
